# ================= JARVIS Voice Assistant =================
# Sao chép file này thành `.env` rồi điền giá trị.
# TẤT CẢ các biến đều là TÙY CHỌN — không có biến nào thì trợ lý
# vẫn chạy được (chế độ tìm kiếm web trực tiếp, không cần API key).

# ---- Server ----
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info            # debug | info | warn | error

# ---- LLM: bật chế độ agent thông minh (điền 1 trong 2 key, hoặc cả 2) ----
# Có key: AI tự quyết định khi nào cần tìm web tùy độ khó câu hỏi,
#         nhớ hội thoại và tự lưu thông tin về bạn (tool "remember").
# Không có key: hệ thống tự chuyển sang chế độ tìm kiếm trực tiếp.
# Có CẢ 2 key: ưu tiên Claude, OpenAI là dự phòng tự động.

# Claude (Anthropic) — lấy key tại https://platform.claude.com/
#ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_EFFORT=medium      # low | medium | high | xhigh | max (thấp = nhanh hơn, phù hợp trợ lý giọng nói)
CLAUDE_MAX_TOKENS=8192

# OpenAI — lấy key tại https://platform.openai.com/api-keys
#OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o       # hoặc: gpt-5, gpt-5-mini, gpt-4o-mini... (tùy tài khoản của bạn)
#OPENAI_BASE_URL=          # tùy chọn: endpoint tương thích OpenAI (gateway, LLM nội bộ)

# Ép chọn backend thay vì tự động: auto | claude | openai | none
LLM_PROVIDER=auto

# ---- Tìm kiếm web (tùy chọn — không có thì dùng DuckDuckGo/Wikipedia miễn phí) ----
#BRAVE_SEARCH_API_KEY=
#TAVILY_API_KEY=

# ---- Hành vi ----
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
DEFAULT_CITY=Hà Nội       # dùng khi hỏi "thời tiết" mà không nói địa điểm (chế độ không LLM)
SEARCH_TIMEOUT_MS=9000
PAGE_TIMEOUT_MS=10000
SESSION_TTL_MINUTES=120
MAX_HISTORY_TURNS=12
#DATA_DIR=./data          # nơi lưu hội thoại + trí nhớ dài hạn (mặc định jarvis/data)
