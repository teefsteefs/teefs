# ================= JARVIS Voice Assistant =================
# Sao chép file này thành `.env` rồi điền giá trị.
# TẤT CẢ các biến đều là TÙY CHỌN — không có biến nào thì trợ lý
# vẫn chạy được (chế độ tìm kiếm web trực tiếp, không cần API key).

# ---- Server ----
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info            # debug | info | warn | error

# ---- Claude (khuyến nghị — bật chế độ agent thông minh) ----
# Có key: Claude tự quyết định khi nào cần tìm web tùy độ khó câu hỏi.
# Không có key: hệ thống tự chuyển sang chế độ tìm kiếm trực tiếp.
# Lấy key tại: https://platform.claude.com/
#ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_EFFORT=medium      # low | medium | high | xhigh | max (thấp = nhanh hơn, phù hợp trợ lý giọng nói)
CLAUDE_MAX_TOKENS=8192

# ---- Tìm kiếm web (tùy chọn — không có thì dùng DuckDuckGo/Wikipedia miễn phí) ----
#BRAVE_SEARCH_API_KEY=
#TAVILY_API_KEY=

# ---- Hành vi ----
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
DEFAULT_CITY=Hà Nội       # dùng khi hỏi "thời tiết" mà không nói địa điểm (chế độ không LLM)
SEARCH_TIMEOUT_MS=9000
PAGE_TIMEOUT_MS=10000
SESSION_TTL_MINUTES=120
MAX_HISTORY_TURNS=12
